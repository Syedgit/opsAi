// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Web application user (supports OAuth 2.0 and email/password)
model User {
  id       String  @id @default(uuid())
  email    String  @unique
  password String? // Hashed password (nullable for OAuth users)
  name     String?
  picture  String? // Profile picture URL (from OAuth)

  // OAuth provider info
  provider     String? @default("email") // 'google', 'github', 'email', etc.
  providerId   String? @map("provider_id") // OAuth provider's user ID
  providerData Json?   @map("provider_data") // Additional OAuth data

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// store. $25 per location after the trial.
  plan        String    @default("store")
  /// trial | active | expired | canceled
  planStatus  String    @default("trial") @map("plan_status")
  trialEndsAt DateTime? @map("trial_ends_at")
  stripeCustomerId     String? @unique @map("stripe_customer_id")
  stripeSubscriptionId String? @unique @map("stripe_subscription_id")

  // Many-to-many relationship with stores
  stores UserStore[]

  @@index([email])
  @@index([provider, providerId])
  @@map("users")
}

// Junction table for User-Store many-to-many relationship
model UserStore {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  storeId   String   @map("store_id")
  role      UserRole @default(OWNER) // OWNER, MANAGER, STAFF
  createdAt DateTime @default(now()) @map("created_at")

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  store StoreConfig @relation(fields: [storeId], references: [storeId], onDelete: Cascade)

  @@unique([userId, storeId])
  @@index([userId])
  @@index([storeId])
  @@map("user_stores")
}

// WhatsApp phone directory (for WhatsApp integration)
model UserDirectory {
  id        String   @id @default(uuid())
  phoneE164 String   @unique @map("phone_e164")
  name      String?
  role      UserRole @default(STAFF)
  storeId   String?  @map("store_id")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([phoneE164])
  @@index([storeId])
  @@map("user_directory")
}

model StoreConfig {
  id        String  @id @default(uuid())
  storeId   String  @unique @map("store_id")
  storeName String  @map("store_name")
  sheetId   String  @map("sheet_id")
  timezone  String  @default("America/New_York")
  active    Boolean @default(true)

  // WhatsApp phone number ID (for shared Meta account)
  // Each store gets its own phone number under our Meta Business Account
  whatsappPhoneNumberId String? @unique @map("whatsapp_phone_number_id")
  whatsappDisplayNumber String? @map("whatsapp_display_number") // Human-readable number

  /// Per-store settings learned from the owner: deposit rule, label dictionary, vendor nicknames, store aliases.
  /// Shape is validated in lib/understanding/profileStore.ts. Null until the owner teaches the store something.
  profileJson Json? @map("profile_json")

  /// What the owner said at setup: store type, opening hours, shifts, fuel pumps. Shape is validated in lib/tasks/storeSetup.ts.
  setupJson Json? @map("setup_json")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Many-to-many relationship with users
  users UserStore[]

  // Optional: one business number, many groups — Meta group_id → store
  whatsappGroups StoreWhatsAppGroup[]

  /// Meta Groups API: async create tracked until group_lifecycle webhook links group_id
  whatsappGroupProvisions WhatsAppGroupProvision[]

  @@index([storeId])
  @@index([whatsappPhoneNumberId])
  @@map("store_config")
}

// Maps Meta WhatsApp group_id (from Cloud API / Groups) to a store (when using group-based routing)
model StoreWhatsAppGroup {
  id              String   @id @default(uuid())
  whatsappGroupId String   @unique @map("whatsapp_group_id")
  storeId         String   @map("store_id")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  store StoreConfig @relation(fields: [storeId], references: [storeId], onDelete: Cascade)

  @@index([storeId])
  @@index([whatsappGroupId])
  @@map("store_whatsapp_groups")
}

enum WhatsAppGroupProvisionStatus {
  PENDING_WEBHOOK
  LINKED
  FAILED
}

/// Tracks POST /phone_number_id/groups until Meta sends group_lifecycle_update (request_id correlation).
model WhatsAppGroupProvision {
  id               String                       @id @default(uuid())
  storeId          String                       @map("store_id")
  createdByUserId  String?                      @map("created_by_user_id")
  status           WhatsAppGroupProvisionStatus @default(PENDING_WEBHOOK)
  subject          String
  description      String?
  joinApprovalMode String                       @default("auto_approve") @map("join_approval_mode")
  /// Meta Groups API request_id from create response + webhook
  metaRequestId    String?                      @unique @map("meta_request_id")
  whatsappGroupId  String?                      @map("whatsapp_group_id")
  inviteLink       String?                      @map("invite_link")
  lastError        String?                      @map("last_error")
  createdAt        DateTime                     @default(now()) @map("created_at")
  updatedAt        DateTime                     @updatedAt @map("updated_at")

  store StoreConfig @relation(fields: [storeId], references: [storeId], onDelete: Cascade)

  @@index([storeId])
  @@index([status])
  @@map("whatsapp_group_provisions")
}

model PendingActions {
  id               String             @id @default(uuid())
  actionId         String             @unique @default(uuid()) @map("action_id")
  phoneE164        String             @map("phone_e164")
  storeId          String             @map("store_id")
  type             ClassificationType
  payloadJson      Json               @map("payload_json")
  confidence       Float
  status           PendingStatus      @default(PENDING)
  messageIdInbound String?            @map("message_id_inbound")
  createdAt        DateTime           @default(now()) @map("created_at")
  expiresAt        DateTime           @map("expires_at")

  @@index([phoneE164, status])
  @@index([storeId])
  @@index([actionId])
  @@map("pending_actions")
}

model VendorContacts {
  id             String     @id @default(uuid())
  storeId        String     @map("store_id")
  vendorName     String     @map("vendor_name")
  sendMethod     SendMethod @map("send_method")
  destination    String
  formatTemplate String?    @map("format_template")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  @@index([storeId, vendorName])
  @@map("vendor_contacts")
}

/// A recurring task a store wants done (check coffee, clean restrooms, label check every hour...).
/// Configured per store from the dashboard. Times are the store's local time.
model TaskTemplate {
  id                   String   @id @default(uuid())
  storeId              String   @map("store_id")
  title                String
  instructions         String?
  /// See TASK_CATEGORIES in lib/tasks/schedule.ts (7-Eleven inspection categories plus generic ones).
  category             String   @default("other")
  /// Inspection standard this task belongs to, like "FS6" (7-Eleven 7Clean). Display and grouping only.
  standardId           String?  @map("standard_id")
  /// critical | major | minor. Sets the default points (50 / 20 / 3).
  criticality          String?
  /// A numeric answer must be at least / at most this (for example cold holding at most 40, roller grill at least 140).
  minValue             Float?   @map("min_value")
  maxValue             Float?   @map("max_value")
  /// Shown next to the limit, like "F".
  unit                 String?
  /// What to do when the answer is that something is broken (for example "hand-label with a marker and log it").
  fallback             String?
  /// Free label, e.g. "Morning", "Night". Display only.
  shift                String?
  /// "HH:MM" local time the task is first due.
  startTime            String   @map("start_time")
  /// With repeatEveryMinutes: the last time of day it repeats until.
  endTime              String?  @map("end_time")
  repeatEveryMinutes   Int?     @map("repeat_every_minutes")
  /// weekly (the weekdays below) | interval (every intervalDays days from anchorDate) | monthly (monthDays) | once (anchorDate only)
  frequency            String   @default("weekly")
  intervalDays         Int?     @map("interval_days")
  /// Days of the month, 1-31 (29-31 fall on the last day of a shorter month).
  monthDays            Int[]    @map("month_days")
  /// "YYYY-MM-DD" in store time: where an "every N days" count starts.
  anchorDate           String?  @map("anchor_date")
  /// 0 = Sunday ... 6 = Saturday
  daysOfWeek           Int[]    @map("days_of_week")
  /// photo | text | either | none
  evidence             String   @default("either")
  /// When set, a photo sent as proof is checked by AI against this text. Costs one AI reading per photo.
  photoCheck           String?  @map("photo_check")
  points               Int      @default(1)
  remindEveryMinutes   Int      @default(15) @map("remind_every_minutes")
  /// Tell the owner/managers when still open this long after it was due.
  escalateAfterMinutes Int?     @default(60) @map("escalate_after_minutes")
  /// Done after this many minutes counts as late.
  lateAfterMinutes     Int      @default(60) @map("late_after_minutes")
  active               Boolean  @default(true)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@index([storeId, active])
  @@map("task_templates")
}

/// One occurrence of a task on one day. Stays OPEN (and keeps reminding) until evidence arrives.
model TaskRun {
  id                String    @id @default(uuid())
  templateId        String    @map("template_id")
  storeId           String    @map("store_id")
  /// Copied from the template so history does not change when the template is edited.
  title             String
  category          String
  standardId        String?   @map("standard_id")
  criticality       String?
  minValue          Float?    @map("min_value")
  maxValue          Float?    @map("max_value")
  unit              String?
  fallback          String?
  evidence          String
  points            Int
  lateAfterMinutes  Int       @default(60) @map("late_after_minutes")
  dueAt             DateTime  @map("due_at")
  /// Store-local calendar day, "YYYY-MM-DD".
  localDate         String    @map("local_date")
  /// Number the employee types to answer this task. Unique per store per local day.
  code              Int
  /// OPEN | DONE | MISSED
  status            String    @default("OPEN")
  alertedAt         DateTime? @map("alerted_at")
  lastReminderAt    DateTime? @map("last_reminder_at")
  reminderCount     Int       @default(0) @map("reminder_count")
  escalatedAt       DateTime? @map("escalated_at")
  completedAt       DateTime? @map("completed_at")
  completedByPhone  String?   @map("completed_by_phone")
  evidenceType      String?   @map("evidence_type")
  evidenceText      String?   @map("evidence_text")
  evidenceMediaId   String?   @map("evidence_media_id")
  evidenceMessageId String?   @map("evidence_message_id")
  /// pass | fail (last reading was outside the limit) | problem (employee reported something broken) | fixed (failed or problem, then resolved)
  outcome           String?
  /// Last numeric answer, when the task has a limit.
  resultValue       Float?    @map("result_value")
  /// What the photo must show (copied from the task when this run was created).
  photoCheck        String?   @map("photo_check")
  /// pass | fail | unclear | unchecked (AI off, over its daily limit or unreachable) | approved (a manager accepted it)
  photoVerdict      String?   @map("photo_verdict")
  /// The AI's one-line reason.
  photoNote         String?   @map("photo_note")
  /// Photos sent so far that did not pass.
  photoMisses       Int       @default(0) @map("photo_misses")
  /// What the employee said was wrong.
  issueText         String?   @map("issue_text")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@unique([templateId, dueAt])
  @@index([storeId, localDate])
  @@index([storeId, status])
  @@map("task_runs")
}

/// An inspector's report (7Clean "Debrief Report") that an owner or manager imported. Only the result and the
/// failed standards are kept: no manager name, email, signature or the PDF itself.
model InspectionReport {
  id          String   @id @default(uuid())
  storeId     String   @map("store_id")
  /// The day of the visit (UTC midnight of the store-local date in the report).
  inspectedOn DateTime @map("inspected_on")
  cycle       Int?
  visit       Int?
  percent     Float
  earned      Int?
  possible    Int?
  /// As printed on the report, like "33336: Mount Laurel, NJ".
  property    String?
  /// [{ label, earned, possible }]
  categories  Json
  /// [{ standardId, question, criticality, points, comment, details, repeat }]
  findings    Json
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([storeId, inspectedOn, percent])
  @@index([storeId, inspectedOn])
  @@map("inspection_reports")
}

model MessageLog {
  id             String   @id @default(uuid())
  messageId      String   @unique @map("message_id")
  phoneE164      String   @map("phone_e164")
  storeId        String?  @map("store_id")
  messageType    String   @map("message_type")
  messageText    String?  @map("message_text")
  mediaUrl       String?  @map("media_url")
  mediaId        String?  @map("media_id")
  classification String?  @map("classification")
  extractedData  Json?    @map("extracted_data")
  processed      Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([messageId])
  @@index([phoneE164])
  @@index([storeId])
  @@index([createdAt])
  @@map("message_log")
}

enum UserRole {
  OWNER
  MANAGER
  STAFF
}

enum ClassificationType {
  ORDER_REQUEST
  STORE_SALES
  FUEL_SALES
  INVOICE_EXPENSE
  PAID_OUT
  UNKNOWN
}

enum PendingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum SendMethod {
  WHATSAPP
  SMS
  EMAIL
}
