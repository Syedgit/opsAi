# Server
PORT=3000
NODE_ENV=development

# Authentication
# Generate a secure JWT secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-secure-random-jwt-secret-here-minimum-32-characters
# Admin API: Bearer token for /api/admin/* routes (generate like JWT_SECRET)
ADMIN_API_KEY=
# Founder emails that can open /internal (comma-separated). Required in production.
ADMIN_EMAILS=you@store.com
# Invite code required for staff to join an existing store via dashboard
STORE_LINK_INVITE_CODE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# WhatsApp Business API — one verified business number for all stores
WHATSAPP_ACCESS_TOKEN=                    # Shared access token for all stores
WHATSAPP_BUSINESS_ACCOUNT_ID=             # Optional if you only use WHATSAPP_PHONE_NUMBER_ID
WHATSAPP_PHONE_NUMBER_ID=                 # Your single verified opsAi WhatsApp number
OPS_WHATSAPP_DISPLAY_NUMBER=              # Human-readable number shown in onboarding/dashboard (e.g. +1 555 010 0000)
WHATSAPP_APP_SECRET=                      # Required in production for webhook signature verification
WHATSAPP_WEBHOOK_VERIFY_TOKEN=           # Webhook verification token
# Store resolution: group (recommended — one number, route by group_id) | phone_number | both
WHATSAPP_STORE_ROUTING=group
# Path A (default false): manual WhatsApp groups. Path B / phase 2: set true for Meta Groups API auto-create on signup
WHATSAPP_GROUP_AUTO_PROVISION=false

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/opsai?schema=public

# AWS S3 (for image storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_REGION=us-east-1

# Google Cloud Vision (OCR)
GOOGLE_VISION_API_KEY=
# OR use service account
GOOGLE_APPLICATION_CREDENTIALS=./path/to/service-account-key.json

# Google Sheets API
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEETS_PROJECT_ID=

# OpenAI (for AI classification & extraction)
OPENAI_API_KEY=
# Dashboard AI summary + Books entry/exit (text)
OPENAI_MODEL=gpt-4o-mini

# Message understanding: WhatsApp text/photos into sales / invoices / deposits / equipment.
# OFF until API key + EXTRACTION_MODEL are set. EXTRACTION must support image input.
OPENAI_EXTRACTION_MODEL=gpt-4o
# Voice notes are ignored by the app (no reply, no AI). This setting is currently unused.
OPENAI_TRANSCRIPTION_MODEL=

# Cheaper text model for typed WhatsApp + Books classify/summarize (photos keep EXTRACTION)
OPENAI_TEXT_MODEL=gpt-4o-mini

# AI cost guards (rolling 24h). Keep these low until client pricing is set.
MAX_AI_MESSAGES_PER_STORE_PER_DAY=20
MAX_TASK_PHOTO_CHECKS_PER_STORE_PER_DAY=15
MAX_AI_USD_PER_STORE_PER_DAY=0.50
MAX_AI_USD_PER_DAY=1.00

# Only for the cost estimate if you use a model not in lib/understanding/usage.ts (USD per million tokens)
# AI_PRICE_INPUT_PER_M=
# AI_PRICE_OUTPUT_PER_M=
# Kill switch: set to "off" to disable message understanding without removing the keys.
# AI_UNDERSTANDING=off
# OR use Anthropic
# ANTHROPIC_API_KEY=

# Redis (for job queue)
REDIS_URL=redis://localhost:6379

# Email (for vendor sending)
SENDGRID_API_KEY=
# OR AWS SES
# AWS_SES_REGION=

# Application
APP_URL=http://localhost:3000
LOG_LEVEL=info

# Owner onboarding: placeholder Google Sheet ID until the store connects a real spreadsheet (required by StoreConfig).
ONBOARDING_DEFAULT_SHEET_ID=pending_google_sheet

# Launch billing: 14-day trial (no card), then 25 USD per store per month. No reading cap on the plan.
# Stripe: create a Product priced $25/month, then paste the secret key and Price ID.
# Optional Books add-on: second Price at $20/month — billed per store with aiChat.enrolled.
# Webhook URL: https://YOUR_DOMAIN/api/webhook/stripe
# Events: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted, invoice.paid, invoice.payment_failed
# Local: stripe listen --forward-to localhost:3000/api/webhook/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_BOOKS_PRICE_ID=

# AI chat / Books (admin add-on, ~$20/store/mo). Owners enroll from Store admin (profileJson.aiChat.enrolled).
# Optional kill switch only: set false to block new enrollments globally. Omit or leave unset in normal production.
# AI_CHAT_SELF_ENROLL=false

# Outbound owner digests (Resend). From must be a verified domain sender.
# RESEND_API_KEY=
# EMAIL_FROM=opsAi <alerts@opsai.us>

# Slack bot (Events API + Bot token). Map workspace users by email to opsAi owners.
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=
# Optional: default channel for digests when store profile omits channelId
# SLACK_DEFAULT_CHANNEL=

# Abuse/cost guard: messages one phone number may send per hour (default 60)
MAX_MESSAGES_PER_HOUR=60

# Secret that lets the scheduler call /api/cron/tasks (task alerts). 16+ random characters. Without it the endpoint refuses everything.
CRON_SECRET=

# Local app only: ms between task ticks. Default 0 (off). A cold tick can alert a backlog across every store — enable only when you want it (e.g. 60000).
# LOCAL_TASK_TICK_MS=60000

