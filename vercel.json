{
  "version": 2,
  "rewrites": [
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/signup",
      "destination": "/signup.html"
    },
    {
      "source": "/onboarding",
      "destination": "/onboarding.html"
    },
    {
      "source": "/api/setup/readiness",
      "destination": "/api/setup/readiness.ts"
    },
    {
      "source": "/api/onboarding/status",
      "destination": "/api/onboarding/index.ts"
    },
    {
      "source": "/api/onboarding/complete-store",
      "destination": "/api/onboarding/index.ts"
    },
    {
      "source": "/api/auth/google/callback",
      "destination": "/api/auth/google.ts"
    },
    {
      "source": "/api/auth/google/initiate",
      "destination": "/api/auth/google.ts"
    },
    {
      "source": "/api/auth/login",
      "destination": "/api/auth/index.ts"
    },
    {
      "source": "/api/auth/signup",
      "destination": "/api/auth/index.ts"
    },
    {
      "source": "/api/auth/me",
      "destination": "/api/auth/index.ts"
    },
    {
      "source": "/api/stores/dashboard",
      "destination": "/api/stores/index.ts"
    },
    {
      "source": "/api/stores/data",
      "destination": "/api/stores/data.ts"
    },
    {
      "source": "/api/stores/summary",
      "destination": "/api/stores/summary.ts"
    },
    {
      "source": "/api/stores/:storeId/link",
      "destination": "/api/stores/[storeId]/link.ts"
    },
    {
      "source": "/api/stores/detail",
      "destination": "/api/stores/index.ts"
    },
    {
      "source": "/api/stores/:storeId/whatsapp-group-provision",
      "destination": "/api/stores/[storeId]/whatsapp-group-provision.ts"
    },
    {
      "source": "/api/stores",
      "destination": "/api/stores/index.ts"
    },
    {
      "source": "/api/admin/phone-numbers",
      "destination": "/api/admin/phone-numbers.ts"
    },
    {
      "source": "/api/admin/stores/:storeId/phone-number",
      "destination": "/api/admin/stores/[storeId]/phone-number.ts"
    },
    {
      "source": "/api/admin/setup/whatsapp-routing",
      "destination": "/api/admin/setup/whatsapp-routing.ts"
    },
    {
      "source": "/api/admin/stores/:storeId/whatsapp-group",
      "destination": "/api/admin/stores/[storeId]/whatsapp-group.ts"
    }
  ],
  "headers": [
    {
      "source": "/(.*\\.html)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:;"
        }
      ]
    }
  ]
}

